{
  "name": "cairn",
  "private": true,
  "version": "0.1.0",
  "description": "Cairn — a warm, calm goal tracker. Set the goal. Keep the pace. Notice how each day feels.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "test": "npm run test --workspace server"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
